# Local development only. Never commit populated secret files.
POSTGRES_DB=xpace
POSTGRES_USER=xpace
POSTGRES_PASSWORD=replace-with-a-local-secret

REDIS_PASSWORD=replace-with-a-local-secret

MINIO_ROOT_USER=xpace-local
MINIO_ROOT_PASSWORD=replace-with-a-local-secret

# API (used when running the API process on the host machine)
DATABASE_URL=postgres://xpace:replace-with-a-local-secret@127.0.0.1:5432/xpace?sslmode=disable
API_SESSION_SIGNING_KEY=replace-with-a-32-byte-minimum-local-secret
API_SESSION_SIGNING_KEY_PREVIOUS=
XPACE_RELEASE=development
XPACE_PUBLIC_URL=http://localhost:3300
GOVERNANCE_RETENTION_WORKER_ENABLED=true
GOVERNANCE_RETENTION_INITIAL_DELAY=1m
GOVERNANCE_RETENTION_INTERVAL=24h
MEETING_DURATION_WORKER_ENABLED=true
MEETING_DURATION_INITIAL_DELAY=30s
MEETING_DURATION_INTERVAL=30s
DATA_EXPORT_WORKER_ENABLED=true
DATA_EXPORT_WORKER_INITIAL_DELAY=15s
DATA_EXPORT_WORKER_INTERVAL=30s
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
BILLING_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_URL=https://api.xendit.co
# Local development only. Never enable this in staging or production.
EMAIL_DEV_RETURN_TOKEN=false
TERMS_VERSION=2026-08-29
PRIVACY_VERSION=2026-08-29
RECORDING_CONSENT_VERSION=2026-08-29
COOKIE_SECURE=false
LIVEKIT_API_KEY=xpace-local-key
LIVEKIT_API_SECRET=replace-with-a-32-byte-minimum-livekit-secret
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
RECORDING_S3_PUBLIC_ENDPOINT=http://localhost:9000
COTURN_AUTH_SECRET=replace-with-a-32-byte-minimum-turn-secret
COTURN_REALM=turn.localhost

# Private production observability (compose.observability.yaml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-observability-secret
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB
XSPACE_OPERATIONS_TENANT_SLUG=cankonix
ALERTMANAGER_WEBHOOK_SECRET=replace-with-a-32-byte-minimum-alert-webhook-secret
INCIDENT_ESCALATION_WORKER_ENABLED=true
INCIDENT_ESCALATION_INITIAL_DELAY=1m
INCIDENT_ESCALATION_INTERVAL=1m

# Fixed service ports: Web 3300, API 8080, PostgreSQL 5432, Redis 6379,
# MinIO API 9000, MinIO Console 9001.
# Web server-side proxy target
API_URL=http://127.0.0.1:8080

# TLS deployment (used with compose.proxy.yaml). Both DNS records must point
# to the host running Traefik and ports 80/443 must be publicly reachable.
XPACE_DOMAIN=xspace.cankonix.com
LIVEKIT_DOMAIN=livekit.xspace.cankonix.com
ACME_EMAIL=ops@example.com
